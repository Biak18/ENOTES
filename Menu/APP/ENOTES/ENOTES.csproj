<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>ENOTES_App</AssemblyName>
		<RootNamespace>ENOTES</RootNamespace>
		<ApplicationIcon>enotes.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="enotes.ico" />
		<Resource Include="enotes.ico" />
	</ItemGroup>
	
    <ItemGroup>
        <PackageReference Include="DevExpress.Win" Version="22.1.6" />
        <PackageReference Include="DevExpress.Win.Design" Version="22.1.6" />
        <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.1" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
        <PackageReference Include="Microsoft.SqlServer.Server" Version="1.0.0" />
		<PackageReference Include="Microsoft.Extensions.Identity.Core" Version="2.3.0" />
		<PackageReference Include="Supabase" Version="1.1.1" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="CH.Framework.Win">
            <SpecificVersion>false</SpecificVersion>
            <HintPath>$(SolutionDir)\..\Dev_Deploy\CH.Framework.Win.dll</HintPath>
        </Reference>
        <Reference Include="CH.Framework.Win.Controls">
            <SpecificVersion>false</SpecificVersion>
            <HintPath>$(SolutionDir)\..\Dev_Deploy\CH.Framework.Win.Controls.dll</HintPath>
        </Reference>
        <Reference Include="CH.Helper">
            <SpecificVersion>false</SpecificVersion>
            <HintPath>$(SolutionDir)\..\Dev_Deploy\CH.Helper.dll</HintPath>			
        </Reference>
        <Reference Include="CH.Grid">
            <SpecificVersion>false</SpecificVersion>
            <HintPath>$(SolutionDir)\..\Dev_Deploy\CH.Grid.dll</HintPath>
        </Reference>
        <Reference Include="CH.Framework.Common">
            <SpecificVersion>false</SpecificVersion>
            <HintPath>$(SolutionDir)\..\Dev_Deploy\CH.Framework.Common.dll</HintPath>
        </Reference>
		<Reference Include="CH">
			<SpecificVersion>false</SpecificVersion>
			<HintPath>$(SolutionDir)\..\Dev_Deploy\CH.dll</HintPath>
		</Reference>
		<Reference Include="SNOTES_SKIN">
		  <HintPath>$(SolutionDir)\..\Dev_Deploy\SNOTES_SKIN.dll</HintPath>
		</Reference>
		<Reference Include="DevExpress.BonusSkins.v22.1">
			<HintPath>$(SolutionDir)\..\Dev_Deploy\DevExpress.BonusSkins.v22.1.dll</HintPath>
		</Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(SolutionDir)..\Dev_Deploy\&quot;" />
	</Target>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>